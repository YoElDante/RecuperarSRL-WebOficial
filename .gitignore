# Dependencies
node_modules/

# Raw product source material (images/PDFs inbox, not site code).
# Anchored to the repo root on purpose: an unanchored `productos/` would also
# swallow src/pages/productos/, silently dropping the catalog routes.
/productos/

# Downloaded reference sites (inspiration only, never shipped)
/inspiraciones/

# Build output
dist/
build/

# Astro generated types and cache
.astro/

# Environment
.env
.env.*

# IDE / OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# Logs
*.log
npm-debug.log*
