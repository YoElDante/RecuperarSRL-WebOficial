---
/*
 * La Empresa — institutional page.
 *
 * The hero runs the plant footage behind the presentation, slightly blurred so
 * the source's softness reads as depth instead of loss of quality. The aerial
 * photo of the plant anchors the "Quiénes somos" block; the rest of the page is
 * company band, verifiable stats and CTA.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/primitives/Hero.astro';
import SectionTitle from '../components/primitives/SectionTitle.astro';
import FeatureList from '../components/primitives/FeatureList.astro';
import MediaBand from '../components/primitives/MediaBand.astro';
import StatsStrip from '../components/primitives/StatsStrip.astro';
import CTABand from '../components/primitives/CTABand.astro';
import { getPagina, getHome, getContacto } from '../lib/site';
import { buildMeta } from '../lib/seo';
import plantaPoster from '../assets/img/planta-poster.jpg';
import aerea from '../assets/img/aerea_planta.avif';

const meta = buildMeta({
  titulo: 'La Empresa — RECUPERAR S.R.L.',
  descripcion:
    'Empresa minera e industrial cordobesa, 100 % capitales nacionales. Primera fábrica argentina de fertilizantes microgranulados, con cantera propia e I+D.',
  canonical: '/la-empresa',
});

const empresa = await getPagina('empresa');
const home = await getHome();
const contacto = await getContacto();
---

<BaseLayout meta={meta} actual="/la-empresa">
  <Hero
    variant="page"
    kicker="La Empresa"
    titulo={empresa?.titulo ?? 'La Empresa'}
    bajada={empresa?.intro}
    imagen={plantaPoster}
    video={{ src: '/media/planta-loop.mp4', blur: 3, opacidad: 0.4 }}
  />

  {
    empresa && (
      <section class="section">
        <div class="container quienes">
          {empresa.aerea && (
            <figure class="quienes__aerea">
              <Image
                src={aerea}
                alt={empresa.aerea.alt}
                width={340}
                class="quienes__aerea-img"
                loading="lazy"
                decoding="async"
              />
              <figcaption>{empresa.aerea.caption}</figcaption>
            </figure>
          )}
          <div class="quienes__copy">
            <SectionTitle
              eyebrow="Quiénes somos"
              titulo="Una empresa minera e industrial con historia"
              descripcion="Desde 2000 trabajamos para que cada nutriente llegue en la forma y el momento en que el cultivo lo necesita."
            />
            <FeatureList items={empresa.secciones} columnas={2} />
          </div>
        </div>
      </section>
    )
  }

  {
    home && (
      <MediaBand
        titulo={home.bandaEmpresa.titulo}
        texto={home.bandaEmpresa.texto}
        items={home.bandaEmpresa.items}
        accion={{ label: 'Conocé los productos', href: '/productos' }}
        tono="oscuro"
      />
    )
  }

  {home && <StatsStrip items={home.stats} />}

  {
    contacto && (
      <CTABand
        titulo="¿Querés conocer nuestra planta?"
        texto="Coordinamos visitas y reuniones técnicas con productores y distribuidores."
        whatsapp={contacto.whatsapp}
        accionSecundaria={{ label: 'Ir a contacto', href: '/contacto' }}
      />
    )
  }
</BaseLayout>

<style>
  .quienes {
    display: grid;
    gap: var(--space-6);
    align-items: start;
    grid-template-columns: 1fr;
  }
  .quienes__aerea {
    margin: 0;
  }
  .quienes__aerea-img {
    width: 100%;
    max-width: 340px;
    height: auto;
    border-radius: var(--radius);
    box-shadow: var(--shadow-2);
  }
  .quienes__aerea figcaption {
    margin-top: var(--space-2);
    max-width: 340px;
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  @media (min-width: 1024px) {
    .quienes {
      grid-template-columns: 340px 1fr;
      gap: var(--space-7);
    }
  }
</style>
