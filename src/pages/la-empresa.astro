---
/*
 * La Empresa — institutional page.
 *
 * The hero runs the plant footage behind the presentation, blurred so the
 * source's softness reads as depth rather than loss of quality. Under it the
 * page opens with the section title, the warehouse panorama and the company
 * cards, and only later introduces the plant itself: the aerial photo paired
 * with a card, because a vertical photo floating on its own never looks
 * integrated with the rest of the page.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/primitives/Hero.astro';
import SectionTitle from '../components/primitives/SectionTitle.astro';
import FeatureList from '../components/primitives/FeatureList.astro';
import StatsStrip from '../components/primitives/StatsStrip.astro';
import CTABand from '../components/primitives/CTABand.astro';
import Icon from '../components/primitives/Icon.astro';
import { getPagina, getHome, getContacto } from '../lib/site';
import { buildMeta } from '../lib/seo';
import { url } from '../lib/urls';
import plantaPoster from '../assets/img/planta-poster.jpg';
import aerea from '../assets/img/aerea_planta.avif';
import personal from '../assets/img/personal-planta.jpg';

const meta = buildMeta({
  titulo: 'La Empresa — RECUPERAR S.R.L.',
  descripcion:
    'Empresa minera e industrial cordobesa, 100 % capitales nacionales. Primera fábrica argentina de fertilizantes microgranulados, con cantera propia e I+D.',
  canonical: '/la-empresa',
});

const empresa = await getPagina('empresa');
const home = await getHome();
const contacto = await getContacto();
---

<BaseLayout meta={meta} actual="/la-empresa">
  <Hero
    variant="page"
    kicker="La Empresa"
    titulo={empresa?.titulo ?? 'La Empresa'}
    bajada={empresa?.intro}
    imagen={plantaPoster}
    video={{ src: '/media/planta-loop.mp4', blur: 3, opacidad: 0.4 }}
  />

  {
    empresa && (
      <section class="section">
        <div class="container">
          <SectionTitle
            eyebrow="Quiénes somos"
            titulo="Una empresa minera e industrial con historia"
            descripcion="Desde 2000 trabajamos para que cada nutriente llegue en la forma y el momento en que el cultivo lo necesita."
          />

          {empresa.panorama && (
            <figure class="pano">
              <Image
                src={personal}
                alt={empresa.panorama.alt}
                widths={[400, 800]}
                sizes="(min-width: 1024px) 1160px, 100vw"
                class="pano__img"
                loading="lazy"
                decoding="async"
              />
              <figcaption>{empresa.panorama.caption}</figcaption>
            </figure>
          )}

          <FeatureList items={empresa.secciones} columnas={2} />
        </div>
      </section>
    )
  }

  {
    home && (
      <section class="section">
        <div class="container planta">
          {empresa?.aerea && (
            <figure class="planta__aerea">
              <Image
                src={aerea}
                alt={empresa.aerea.alt}
                width={337}
                class="planta__aerea-img"
                loading="lazy"
                decoding="async"
              />
              <figcaption>{empresa.aerea.caption}</figcaption>
            </figure>
          )}

          <article class="planta__card">
            <p class="planta__eyebrow">La planta y el yacimiento</p>
            <h2>{home.bandaEmpresa.titulo}</h2>
            <p class="planta__texto">{home.bandaEmpresa.texto}</p>
            <ul class="planta__items">
              {
                home.bandaEmpresa.items.map((item) => (
                  <li>
                    <Icon name="check" size={16} />
                    <span>{item}</span>
                  </li>
                ))
              }
            </ul>
            <a class="btn btn-outline" href={url('/productos')}>
              Conocé los productos
              <Icon name="arrow-right" size={16} />
            </a>
          </article>
        </div>
      </section>
    )
  }

  {home && <StatsStrip items={home.stats} />}

  {
    contacto && (
      <CTABand
        titulo="¿Querés conocer nuestra planta?"
        texto="Coordinamos visitas y reuniones técnicas con productores y distribuidores."
        whatsapp={contacto.whatsapp}
        accionSecundaria={{ label: 'Ir a contacto', href: '/contacto' }}
      />
    )
  }
</BaseLayout>

<style>
  /* Warehouse strip: the source is 800x200, so it is shown wide and short,
     which is also how the frame was composed. */
  .pano {
    margin: var(--space-6) 0 var(--space-7);
  }
  .pano__img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    box-shadow: var(--shadow-2);
  }
  .pano figcaption {
    margin-top: var(--space-2);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .planta {
    display: grid;
    gap: var(--space-6);
    align-items: start;
    grid-template-columns: 1fr;
  }
  .planta__aerea {
    margin: 0;
  }
  .planta__aerea-img {
    width: 100%;
    max-width: 337px;
    height: auto;
    border-radius: var(--radius);
    box-shadow: var(--shadow-2);
  }
  .planta__aerea figcaption {
    margin-top: var(--space-2);
    max-width: 337px;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  /* The card is what anchors the photo: same surface and radius language as the
     feature cards above, with the plant facts spelled out beside the image. */
  .planta__card {
    padding: var(--space-5);
    background: var(--surface);
    border-radius: var(--radius);
    border-left: 3px solid var(--brand-100);
    box-shadow: var(--shadow-2);
  }
  .planta__eyebrow {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-size: var(--fs-eyebrow);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-text);
  }
  .planta__card h2 {
    margin: 0 0 var(--space-3);
    font-size: clamp(1.35rem, 2.2vw, 1.75rem);
  }
  .planta__texto {
    margin: 0 0 var(--space-4);
    color: var(--text-muted);
  }
  .planta__items {
    list-style: none;
    margin: 0 0 var(--space-5);
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  .planta__items li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-2);
    align-items: start;
    font-size: 0.95rem;
  }
  .planta__items :global(svg) {
    color: var(--brand-600);
    margin-top: 3px;
    flex-shrink: 0;
  }

  @media (min-width: 1024px) {
    .planta {
      grid-template-columns: 337px 1fr;
      gap: var(--space-7);
    }
    .planta__card {
      padding: var(--space-6);
    }
  }
</style>
