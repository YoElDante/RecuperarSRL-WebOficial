---
/*
 * Cultivos extensivos — grid of the 6 extensive crops.
 * Cross-links to the intensive path; each card opens a crop page.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/primitives/Hero.astro';
import CardGrid from '../../components/primitives/CardGrid.astro';
import CropCard from '../../components/primitives/CropCard.astro';
import CTABand from '../../components/primitives/CTABand.astro';
import { getCropsByTipo } from '../../lib/crops';
import { getContacto } from '../../lib/site';
import { buildMeta } from '../../lib/seo';
import { url } from '../../lib/urls';

const cultivos = await getCropsByTipo('extensivo');
const contacto = await getContacto();

const meta = buildMeta({
  titulo: 'Cultivos extensivos — RECUPERAR S.R.L.',
  descripcion:
    'Recomendaciones de fertilización para soja, maíz, trigo y cebada, girasol, alfalfa y maní.',
  canonical: '/cultivos/extensivos',
});
---

<BaseLayout meta={meta} actual="/cultivos/extensivos">
  <Hero
    variant="page"
    kicker="Cultivos"
    titulo="Cultivos extensivos"
    bajada="Soja, maíz, trigo y cebada, girasol, alfalfa y maní: encontrá los productos recomendados para cada cultivo."
  />

  <section class="section">
    <div class="container">
      <CardGrid columnas={3}>
        {cultivos.map((cultivo) => <CropCard cultivo={cultivo} />)}
      </CardGrid>
      <p class="cross-link">
        ¿Buscás cultivos intensivos? <a href={url('/cultivos/intensivos')}>Ver intensivos →</a>
      </p>
    </div>
  </section>

  {
    contacto && (
      <CTABand
        titulo="¿Querés una recomendación para tu lote?"
        texto="Contanos el cultivo y la zona, y te orientamos con el producto adecuado."
        whatsapp={contacto.whatsapp}
        accionSecundaria={{ label: 'Ir a contacto', href: '/contacto' }}
      />
    )
  }
</BaseLayout>

<style>
  .cross-link {
    margin-top: var(--space-6);
    text-align: center;
    color: var(--text-muted);
  }
</style>
