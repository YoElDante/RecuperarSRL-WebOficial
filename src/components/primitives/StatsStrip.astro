---
/*
 * StatsStrip — verifiable numbers only, no animated counters.
 * Every value must be traceable to docs/ficha-empresa.md or the content model.
 */
interface Props {
  items: Array<{ valor: string; label: string }>;
}
const { items } = Astro.props;
---

<section class="stats-strip">
  <div class="container stats-strip__grid">
    {
      items.map((item) => (
        <div class="stat">
          <span class="stat__valor">{item.valor}</span>
          <span class="stat__label">{item.label}</span>
        </div>
      ))
    }
  </div>
</section>

<style>
  .stats-strip {
    background: var(--brand-50);
    border-block: 1px solid var(--border);
    padding-block: var(--space-6);
  }
  .stats-strip__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
    text-align: center;
  }
  .stat__valor {
    display: block;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    color: var(--brand-600);
    line-height: 1;
  }
  .stat__label {
    display: block;
    margin-top: var(--space-1);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }
  @media (min-width: 768px) {
    .stats-strip__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
