---
/*
 * Hero — typographic hero on deep brand green (PronoAgro language).
 * Optional background image keeps the same structure; without a photo it stays
 * a bold, text-led hero, which is the current v1 decision while the client
 * produces real photography.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import { url } from '../../lib/urls';

export interface Accion {
  label: string;
  href: string;
  variant?: 'primary' | 'outline' | 'brand';
  externo?: boolean;
}

interface Props {
  variant?: 'home' | 'page';
  kicker?: string;
  titulo: string;
  bajada?: string;
  acciones?: Accion[];
  imagen?: ImageMetadata;
}
const { variant = 'page', kicker, titulo, bajada, acciones, imagen } = Astro.props;

/* Map an action variant to the shared button classes. */
const btnClass = (v: Accion['variant'] = 'primary') =>
  v === 'outline' ? 'btn btn-outline' : v === 'brand' ? 'btn btn-brand' : 'btn btn-primary';
---

<section class:list={['hero', `hero--${variant}`]}>
  {imagen && (
    <Image
      src={imagen}
      alt=""
      widths={[768, 1280, 1920]}
      sizes="100vw"
      class="hero__bg"
      loading="eager"
    />
  )}
  <div class="container hero__inner">
    {kicker && <p class="hero__kicker">{kicker}</p>}
    <h1 class="hero__title">{titulo}</h1>
    {bajada && <p class="hero__bajada">{bajada}</p>}
    {acciones && acciones.length > 0 && (
      <div class="hero__actions">
        {acciones.map((a) => (
          <a
            class={btnClass(a.variant)}
            href={url(a.href)}
            target={a.externo ? '_blank' : undefined}
            rel={a.externo ? 'noopener' : undefined}
          >
            {a.label}
            <Icon name="arrow-right" size={16} />
          </a>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: radial-gradient(circle at 30% 20%, var(--brand-700), var(--brand-900) 70%);
    color: #fff;
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.35;
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    padding-block: var(--space-9);
    max-width: var(--container-narrow);
  }
  .hero--home .hero__inner {
    padding-block: var(--space-9);
  }
  .hero--page .hero__inner {
    padding-block: var(--space-8);
  }
  .hero__kicker {
    display: inline-block;
    margin: 0 0 var(--space-4);
    padding: var(--space-1) var(--space-3);
    background: var(--accent-fill);
    color: var(--text);
    font-family: var(--font-display);
    font-size: var(--fs-eyebrow);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-radius: var(--radius);
  }
  .hero__title {
    color: #fff;
    margin-bottom: var(--space-4);
    max-width: 20ch;
  }
  .hero__bajada {
    font-size: 1.15rem;
    color: var(--text-on-dark);
    max-width: 60ch;
    margin-bottom: var(--space-6);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .hero__actions :global(svg) {
    width: 16px;
    height: 16px;
  }
</style>
