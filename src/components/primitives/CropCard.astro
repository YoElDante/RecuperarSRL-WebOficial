---
/*
 * CropCard — card for a crop, linking to its recommendation page.
 * Crop photos are low resolution from the legacy site, so they are capped at
 * 480px and never used as hero or full-bleed media.
 */
import { Image } from 'astro:assets';
import type { Cultivo } from '../../lib/crops';
import { getCropImage } from '../../lib/assets';
import { url } from '../../lib/urls';

interface Props {
  cultivo: Cultivo;
}
const { cultivo } = Astro.props;
const imagen = getCropImage(cultivo.slug);
const href = url(`/cultivos/${cultivo.slug}/`);
---

<a class="crop-card" href={href}>
  <div class="crop-card__media">
    {
      imagen ? (
        <Image
          src={imagen}
          alt={`Cultivo de ${cultivo.nombre}`}
          widths={[240, 400]}
          sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 90vw"
          class="crop-card__img"
          loading="lazy"
        />
      ) : (
        <span class="crop-card__placeholder">{cultivo.nombre}</span>
      )
    }
  </div>
  <div class="crop-card__body">
    <h3>{cultivo.nombre}</h3>
    <p>{cultivo.resumen}</p>
    <span class="crop-card__cta">Ver recomendación →</span>
  </div>
</a>

<style>
  .crop-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-1);
    text-decoration: none;
    color: var(--text);
    transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }
  .crop-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-2);
    color: var(--text);
  }
  .crop-card__media {
    aspect-ratio: 4 / 3;
    background: var(--surface-alt);
    overflow: hidden;
  }
  .crop-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .crop-card__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--brand-700);
    background: var(--brand-50);
  }
  .crop-card__body {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .crop-card h3 {
    margin: 0;
    font-size: 1.1rem;
  }
  .crop-card p {
    margin: 0;
    font-size: 0.88rem;
    color: var(--text-muted);
  }
  .crop-card__cta {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--brand-600);
  }
</style>
