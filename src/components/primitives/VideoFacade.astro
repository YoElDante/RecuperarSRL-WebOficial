---
/*
 * VideoFacade — click-to-play video card with a poster and a custom play button.
 *
 * The file is never requested until the click (`preload="none"`), so a 45 MB
 * technical video costs nothing on page load. This replaces the YouTube iframe
 * that used to leave a black rectangle while its player bootstrapped: a facade
 * paints instantly and the player starts only when the visitor asks for it.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import { url } from '../../lib/urls';

interface Props {
  src: string;
  poster: ImageMetadata;
  titulo: string;
  duracion?: string;
  nota?: string;
}
const { src, poster, titulo, duracion, nota } = Astro.props;
---

<figure class="video-facade">
  <div class="video-facade__frame">
    <Image
      src={poster}
      alt=""
      widths={[480, 800, 1280]}
      sizes="(min-width: 1024px) 640px, 100vw"
      class="video-facade__poster"
      loading="lazy"
      decoding="async"
    />
    <video class="video-facade__video" preload="none" controls playsinline src={url(src)}>
      <!-- Fallback for browsers without video support: never a dead card. -->
      <a href={url(src)}>Descargar el video</a>
    </video>
    <button class="video-facade__play" type="button" aria-label={`Reproducir video: ${titulo}`}>
      <Icon name="play" size={24} />
    </button>
    {duracion && <span class="video-facade__badge">{duracion}</span>}
  </div>

  <figcaption class="video-facade__caption">
    <strong>{titulo}</strong>
    {nota && <span>{nota}</span>}
  </figcaption>
</figure>

<script>
  /*
   * Swap the facade for the real player on demand. Focus moves to the video so
   * keyboard users land where the controls now are, not on a hidden button.
   */
  for (const facade of document.querySelectorAll('.video-facade')) {
    const video = facade.querySelector('video');
    const play = facade.querySelector('button');
    if (!video || !play) continue;

    play.addEventListener('click', () => {
      facade.classList.add('is-playing');
      void video.play();
      video.focus();
    });
  }
</script>

<style>
  .video-facade {
    margin: 0;
  }
  .video-facade__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--brand-900);
    box-shadow: var(--shadow-3);
  }
  .video-facade__poster,
  .video-facade__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .video-facade__poster {
    transition: transform 600ms var(--ease), opacity 300ms var(--ease);
  }
  .video-facade:hover .video-facade__poster {
    transform: scale(1.03);
  }
  .video-facade__video {
    opacity: 0;
    pointer-events: none;
    background: #000;
  }
  .video-facade.is-playing .video-facade__video {
    opacity: 1;
    pointer-events: auto;
  }
  .video-facade.is-playing .video-facade__poster,
  .video-facade.is-playing .video-facade__play,
  .video-facade.is-playing .video-facade__badge {
    opacity: 0;
    pointer-events: none;
  }

  /* Play control: square to match the site's radius language, not a circle. */
  .video-facade__play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    background: var(--accent-fill);
    color: var(--text);
    cursor: pointer;
    box-shadow: var(--shadow-3);
    transition: transform var(--dur) var(--ease), opacity 300ms var(--ease);
  }
  .video-facade__play:hover {
    transform: translate(-50%, -50%) scale(1.06);
  }
  .video-facade__play:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }
  .video-facade__badge {
    position: absolute;
    right: var(--space-3);
    bottom: var(--space-3);
    padding: 2px 8px;
    border-radius: var(--radius);
    background: rgba(5, 40, 23, 0.85);
    color: #fff;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    transition: opacity 300ms var(--ease);
  }
  .video-facade__caption {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: var(--space-3);
    font-size: 0.9rem;
  }
  .video-facade__caption strong {
    font-family: var(--font-display);
    font-size: 1rem;
  }
  .video-facade__caption span {
    color: var(--video-caption-muted, var(--text-muted));
  }
</style>
