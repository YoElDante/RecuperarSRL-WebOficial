---
/*
 * MediaBand — asymmetric 1/3 copy + 2/3 media band (PronoAgro pattern).
 * Without an image it degrades to a typographic panel on the dark brand color,
 * so institutional pages work before real photography exists.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  titulo: string;
  texto: string;
  items?: string[];
  accion?: { label: string; href: string };
  imagen?: ImageMetadata;
  invertida?: boolean;
  tono?: 'claro' | 'oscuro';
}
const { titulo, texto, items, accion, imagen, invertida = false, tono = 'oscuro' } = Astro.props;
---

<section class:list={['media-band', `media-band--${tono}`, { 'media-band--invertida': invertida }]}>
  <div class="container media-band__inner">
    <div class="media-band__copy">
      <h2>{titulo}</h2>
      <p>{texto}</p>
      {
        items && items.length > 0 && (
          <ul>
            {items.map((item) => <li>{item}</li>)}
          </ul>
        )
      }
      {accion && <a class="btn btn-primary" href={accion.href}>{accion.label}</a>}
    </div>
    <div class="media-band__media">
      {
        imagen ? (
          <Image
            src={imagen}
            alt={titulo}
            widths={[480, 800, 1200]}
            sizes="(min-width: 1024px) 60vw, 100vw"
            loading="lazy"
          />
        ) : (
          <div class="media-band__panel" aria-hidden="true">
            <span>{titulo}</span>
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .media-band {
    padding-block: var(--space-8);
  }
  .media-band__inner {
    display: grid;
    gap: var(--space-6);
    align-items: center;
    grid-template-columns: 1fr;
  }
  .media-band--oscuro {
    background: var(--brand-900);
    color: #fff;
  }
  .media-band--oscuro h2 {
    color: #fff;
  }
  .media-band--oscuro p {
    color: var(--text-on-dark);
  }
  .media-band--claro {
    background: var(--bg);
  }
  .media-band__copy ul {
    margin: 0 0 var(--space-5);
    padding-left: var(--space-5);
    color: var(--text-on-dark);
  }
  .media-band--claro .media-band__copy ul {
    color: var(--text-muted);
  }
  .media-band__copy li {
    margin-bottom: var(--space-2);
  }
  .media-band__media :global(img) {
    width: 100%;
    border-radius: var(--radius);
  }
  .media-band__panel {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 260px;
    padding: var(--space-6);
    background: repeating-linear-gradient(
      135deg,
      var(--brand-700),
      var(--brand-700) 12px,
      var(--brand-600) 12px,
      var(--brand-600) 24px
    );
    border-radius: var(--radius);
    text-align: center;
  }
  .media-band__panel span {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.5rem;
    color: #fff;
    opacity: 0.85;
  }

  @media (min-width: 1024px) {
    .media-band__inner {
      grid-template-columns: 1fr 2fr;
    }
    .media-band--invertida .media-band__copy {
      order: 2;
    }
  }
</style>
