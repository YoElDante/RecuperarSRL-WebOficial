---
/*
 * CTABand — full-width gradient conversion band with a WhatsApp button.
 * This is the conversion closer of the agro site: one primary WhatsApp action
 * and an optional secondary link (contact page, catalog, etc.).
 */
import Icon from './Icon.astro';

interface Props {
  titulo: string;
  texto?: string;
  whatsapp?: string;
  accionSecundaria?: { label: string; href: string };
}
const { titulo, texto, whatsapp, accionSecundaria } = Astro.props;
---

<section class="cta-band">
  <div class="container cta-band__inner">
    <div class="cta-band__copy">
      <h2>{titulo}</h2>
      {texto && <p>{texto}</p>}
    </div>
    <div class="cta-band__actions">
      {whatsapp && (
        <a
          class="btn btn-primary"
          href={`https://wa.me/${whatsapp}?text=${encodeURIComponent('Hola, quisiera hacer una consulta.')}`}
          target="_blank"
          rel="noopener"
        >
          <Icon name="whatsapp" size={18} />
          WhatsApp ventas
        </a>
      )}
      {accionSecundaria && (
        <a class="btn btn-outline" href={accionSecundaria.href}>
          {accionSecundaria.label}
        </a>
      )}
    </div>
  </div>
</section>

<style>
  .cta-band {
    background: linear-gradient(135deg, var(--brand-900) 0%, var(--brand-500) 100%);
    border-top: 3px solid var(--accent-fill);
    color: #fff;
    padding-block: var(--space-7);
  }
  .cta-band__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    align-items: flex-start;
  }
  .cta-band h2 {
    color: #fff;
    margin-bottom: var(--space-2);
  }
  .cta-band p {
    color: var(--text-on-dark);
    margin: 0;
    max-width: 60ch;
  }
  .cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  @media (min-width: 768px) {
    .cta-band__inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
