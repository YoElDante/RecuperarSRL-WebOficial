---
/*
 * ContactInfoCard — office, phone zones and mail in a compact card.
 * All values come from the `contacto` content page (ficha-empresa.md).
 */
import type { ContactoData } from '../../lib/site';
import Icon from '../primitives/Icon.astro';

interface Props {
  contactos: ContactoData;
}
const { contactos } = Astro.props;
---

<div class="contact-info">
  <h2>Hablemos</h2>
  <ul class="contact-info__list">
    <li>
      <Icon name="map-pin" size={20} />
      <div>
        <strong>Oficina comercial</strong>
        <span>{contactos.oficina}</span>
      </div>
    </li>
    <li>
      <Icon name="phone" size={20} />
      <div>
        <strong>Ventas</strong>
        <span>{contactos.telefonos[0]?.zona}: {contactos.telefonos[0]?.telefono}</span>
      </div>
    </li>
    <li>
      <Icon name="mail" size={20} />
      <div>
        <strong>Email</strong>
        <a href={`mailto:${contactos.mails[0]}`}>{contactos.mails[0]}</a>
      </div>
    </li>
  </ul>
  <a class="btn btn-whatsapp" href={`https://wa.me/${contactos.whatsapp}`} target="_blank" rel="noopener">
    <Icon name="whatsapp" size={18} />
    WhatsApp ventas
  </a>
</div>

<style>
  .contact-info {
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: 4px solid var(--brand-500);
    border-radius: var(--radius);
    padding: var(--space-5);
    box-shadow: var(--shadow-1);
  }
  .contact-info h2 {
    font-size: 1.35rem;
  }
  .contact-info__list {
    list-style: none;
    margin: 0 0 var(--space-5);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .contact-info__list li {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
  }
  .contact-info__list :global(svg) {
    color: var(--brand-600);
    flex-shrink: 0;
    margin-top: 2px;
  }
  .contact-info__list strong {
    display: block;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--accent-text);
  }
  .contact-info__list span,
  .contact-info__list a {
    font-size: 0.9rem;
    color: var(--text);
    text-decoration: none;
  }
  .contact-info__list a:hover {
    text-decoration: underline;
  }
</style>
