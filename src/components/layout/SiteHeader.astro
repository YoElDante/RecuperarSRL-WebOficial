---
/*
 * SiteHeader — sticky green header with logo, navigation and a Contact CTA.
 * One row on desktop; on mobile it keeps the logo and swaps the nav for the
 * <MobileNav> accordion.
 */
import type { NavItem } from '../../lib/site';
import HeaderDropdown from './HeaderDropdown.astro';
import MobileNav from './MobileNav.astro';
import { url } from '../../lib/urls';

interface Props {
  nav: NavItem[];
  actual?: string;
}
const { nav, actual = '' } = Astro.props;
---

<header class="site-header" id="top">
  <div class="container site-header__inner">
    <a class="brand" href={url('/')} aria-label="RECUPERAR S.R.L. — Inicio">
      <img src={url('/logo.svg')} alt="RECUPERAR S.R.L." width="170" height="38" />
    </a>

    <nav class="nav-desktop" aria-label="Navegación principal">
      {
        nav.map((item) =>
          item.children ? (
            <HeaderDropdown item={item} actual={actual} />
          ) : (
            <a
              class="nav-link"
              href={item.href}
              aria-current={url(actual) === item.href ? 'page' : undefined}
            >
              {item.label}
            </a>
          ),
        )
      }
      <a class="btn btn-primary nav-cta" href={url('/contacto')}>Contacto</a>
    </nav>

    <MobileNav nav={nav} actual={actual} />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: var(--brand-600);
    box-shadow: var(--shadow-2);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    min-height: var(--header-h-sm);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }
  .brand img {
    height: 34px;
    width: auto;
  }
  .nav-desktop {
    display: none;
    align-items: center;
    gap: var(--space-3);
    margin-left: auto;
    height: var(--header-h);
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    height: 100%;
    padding: 0 var(--space-2);
    color: #fff;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    position: relative;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: var(--accent-fill);
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }
  .nav-link:hover::after,
  .nav-link[aria-current='page']::after {
    opacity: 1;
  }
  .nav-cta {
    margin-left: var(--space-3);
    padding: 0.55rem 1.1rem;
    font-size: 0.8rem;
  }

  @media (min-width: 1024px) {
    .site-header__inner {
      min-height: var(--header-h);
    }
    .brand img {
      height: 44px;
    }
    .nav-desktop {
      display: flex;
    }
  }
</style>
